{
  "schemaVersion": 1,
  "id": "worlddriver",
  "version": "${version}",
  "name": "WorldDriver",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "contact": {
    "homepage": "${mod_source_url}",
    "sources": "${mod_source_url}"
  },
  "environment": "*",
  "accessWidener": "worlddriver.accesswidener",
  "mixins": [
    "worlddriver-common.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "net.magicterra.worlddriver.fabric.WorldDriverFabric"
    ],
    "client": [
      "net.magicterra.worlddriver.fabric.client.WorldDriverFabricClient"
    ]
  },
  "depends": {
    "fabricloader": "${fabric_loader_range}",
    "fabric-api": "*",
    "architectury": "${architectury_range}",
    "minecraft": "${minecraft_range}",
    "java": ">=21"
  }
}
