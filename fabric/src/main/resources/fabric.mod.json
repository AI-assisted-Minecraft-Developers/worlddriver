{
  "schemaVersion": 1,
  "id": "worlddriver",
  "version": "${version}",
  "name": "WorldDriver",
  "description": "AI agent driver: Minecraft observation, action and Rhino scripting over an in-game RPC channel.",
  "authors": [
    "AI-assisted-Minecraft-Developers"
  ],
  "license": "LGPL-3.0-only",
  "environment": "*",
  "accessWidener": "worlddriver.accesswidener",
  "mixins": [
    "worlddriver-common.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "net.magicterra.worlddriver.fabric.WorldDriverFabric"
    ],
    "client": [
      "net.magicterra.worlddriver.fabric.client.WorldDriverFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16",
    "fabric-api": "*",
    "architectury": ">=13.0.8",
    "minecraft": ">=1.21",
    "java": ">=21"
  }
}
