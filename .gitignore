build/
.gradle/
*/build/
run/
run-stagewright/
run-dogfood/
run-contract/
# Every ladder topology, not just the headless one. The three play the SAME world in three
# directories on purpose (a playthrough leaves its trees felled and its shafts dug, so two of them
# sharing a directory would each measure the other), and a glob is what keeps a fourth from being
# committable the day it is added.
run-journey*/
run-rehearsal*/
# The lab world (runLabClient) is a tester's own, kept across launches and never committed.
run-lab/
.idea/
*.log
# log4j2 rolls latest.log into dated .gz archives, which *.log does not cover;
# src/test/resources/log4j2-test.xml stops :common:test writing here at all, but
# a stray logs/ from any other cwd must never be committable either (rule #5)
logs/

# Bytecode, repo-wide. These two lines used to be scoped to scripts/ and were
# added AFTER the .pyc files had been committed — and .gitignore does nothing for
# an already-tracked file, so 26 of them stayed in the index across three
# interpreter generations (cpython-312 from the Linux host, 313/314 from a
# Windows checkout). Every run on a different interpreter rewrote them, so
# `git status` was permanently dirty with build output nobody edits.
__pycache__/
*.py[cod]

# The whole run-directory config tree, not just the debug charts. This used to name only
# `worlddriver/debug/`, so when 58 MB of replay corpora were committed under
# `config/agent_driver/replays/` nothing stopped them, and they stayed tracked for weeks after
# the rename orphaned them (the tools read `config/worlddriver/replays/`, the data sat under
# `config/agent_driver/replays/`, and neither side noticed). Everything under config/ is runtime
# output; the corpora that were worth keeping live outside the repo now and
# docs/replay-corpus-regression.md says where.
/config/
**/config/worlddriver/debug/
/.venv/
# local tooling (jacoco jars, coverage output) — never commit
.local/
coverage-out/

# Eclipse/IDE compiled output (was committed by accident before the rename)
bin/

# StageWright's standalone build (added during the repo split) has its own build dirs.
stagewright/.gradle/

# StageWright scene runs. Each topology gets its own game directory so a run never inherits
# the previous one's world; none of it is source, and the results file is regenerated every run.
run-stagewright*/
